<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsAotCompatible>true</IsAotCompatible>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
		<Description>.Net Core interface for the open-source mt32emu/munt MT-32 emulator. This package includes native binaries built for Windows (x64) and Linux (x64), along with a managed wrapper for easy use in .net 10+.</Description>
		<Version>1.0.0</Version>
		<PackageTags>mt32 munt</PackageTags>
		<PackageProjectUrl>https://github.com/gregdivis/mt32emu.net</PackageProjectUrl>
		<RepositoryUrl>https://github.com/gregdivis/mt32emu.net.git</RepositoryUrl>
		<PackageId>Mt32emu.net</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Authors>Greg Divis</Authors>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<NoWarn>CS1591</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md" Link="README.md" Pack="true" PackagePath="/" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="native\linux-x64\libmt32emu.so">
			<PackagePath>runtimes/linux-x64/native/</PackagePath>
			<Pack>true</Pack>
		</Content>
		<Content Include="native\win-x64\libmt32emu.dll">
			<PackagePath>runtimes/win-x64/native/</PackagePath>
			<Pack>true</Pack>
		</Content>
	</ItemGroup>
</Project>
